{
    "model_name": "unsloth/gemma-3-4b-it-qat",
    "description": "System aware agent",
    "system_prompt_file": "nirmata_mk3.md",
    "provider_url": "http://localhost:8081/v1",
    "inference_params": {
        "temperature": 0.6,
        "top_p": 0.96,
        "min_p": 0.05,
        "top_k": 20,
        "repeat_penalty": 1.13,
        "max_tokens": 0
    },
    "enable_max_tool_calls": true,
    "max_sequential_tool_calls": 20,
    "deepagents": {
        "inject_subagents_to_prompt": false,
        "semantic_agent": "Archivist",
        "use_project_deepagents": true,
        "enabled_tools": [
            "query_knowledge_base",
            "analyze_journal_logs",
            "append_to_note",
            "clear_scratchpad",
            "file_contents_search",
            "get_long_term_memory",
            "interactive_web_search",
            "list_memory_namespaces",
            "list_notes",
            "manage_memory",
            "py_syntax_checker",
            "read_note",
            "scrape_indexed_urls",
            "search_vault",
            "store_long_term_memory",
            "write_note",
            "write_to_scratchpad"
        ],
        "enabled_subagents": []
    }
}